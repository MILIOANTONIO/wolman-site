# Copia questo file in ".env.local" (stessa cartella) e incolla i valori veri.
# Il file ".env.local" NON viene mai letto da me, non va su git, e resta solo sul tuo computer.

# Chiave API Resend (per inviare l'email di riepilogo): https://resend.com/api-keys
RESEND_API_KEY=

# Secret del webhook ElevenLabs (dashboard agente > Webhooks)
ELEVENLABS_WEBHOOK_SECRET=

# Indirizzo email a cui inviare il riepilogo di ogni chiamata ricevuta
UNITEL_NOTIFY_EMAIL=
