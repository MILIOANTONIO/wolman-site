# Copia questo file in ".env.local" (stessa cartella) e incolla i valori veri.
# Il file ".env.local" NON viene mai letto da me, non va su git, e resta solo sul tuo computer.

# Database Postgres (locale o Render)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/pizza_saas

# Chiave segreta per firmare i cookie di sessione (una stringa lunga e casuale)
SESSION_SECRET_KEY=

# Google OAuth (console.cloud.google.com > Credenziali > ID client OAuth 2.0)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Anthropic (per l'agente WhatsApp testuale)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ElevenLabs (creazione/aggiornamento agenti vocali via Agents API)
ELEVENLABS_API_KEY=
ELEVENLABS_WEBHOOK_SECRET=

# Resend (email transazionali: attivazione tenant, ecc.)
RESEND_API_KEY=
RESEND_FROM=Pizza SaaS <onboarding@resend.dev>

# WhatsApp Cloud API (Meta) - a livello di app, non per singolo tenant
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# DIDWW (numeri di telefono locali + verifica KYC): my.didww.com > API > Create new API Key
DIDWW_API_KEY=txa0iNK!8hyQHFoL4spXnC5ndMB6Ph4j
DIDWW_ENVIRONMENT=sandbox

# URL pubblico del frontend (per redirect OAuth e CORS)
FRONTEND_URL=http://localhost:3000
